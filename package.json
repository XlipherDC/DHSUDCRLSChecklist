{
  "name": "dhsud-crls-checklist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static CRLS document checklist and source-based fee assessment",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "extract": "powershell -ExecutionPolicy Bypass -File scripts/extract-source.ps1 && node scripts/generate-catalog.mjs",
    "cloudflare:setup": "node scripts/setup-cloudflare.mjs",
    "cloudflare:dev": "wrangler dev --config worker/wrangler.jsonc",
    "cloudflare:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "cloudflare:verify": "node scripts/verify-cloudflare.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.129.1"
  }
}
